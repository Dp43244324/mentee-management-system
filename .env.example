# PostgreSQL connection string from your external PostgreSQL provider (recommended: Neon).
# Do NOT commit the real connection string to GitHub. Add it in Render -> Environment.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Render can generate this automatically from render.yaml.
SECRET_KEY=replace-with-a-long-random-secret

# Keep secure cookies enabled on an HTTPS deployment.
COOKIE_SECURE=1

# Optional local/server port.
PORT=5000

# Optional marker for the college's current term.
# This DOES NOT restrict student registration. Students choose their own
# semester (1-8) on the registration page.
CURRENT_ACADEMIC_YEAR=2026-27
CURRENT_SEMESTER=1
